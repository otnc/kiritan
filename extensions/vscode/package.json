{
  "name": "kiritan",
  "displayName": "Kiritan",
  "description": "Syntax highlighting for Kiritan's :::kiritan{...} directive blocks in Markdown",
  "version": "0.1.1",
  "publisher": "otoneko1102",
  "type": "module",
  "icon": "images/icon.png",
  "license": "WTFPL",
  "author": "otoneko.",
  "homepage": "https://github.com/otnc/kiritan#readme",
  "bugs": {
    "url": "https://github.com/otnc/kiritan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/kiritan.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kiritan",
    "i18n",
    "markdown",
    "directive"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "markdown.kiritan.injection",
        "path": "./syntaxes/kiritan-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  }
}
