{
  "name": "@kiritan/runtime",
  "version": "0.2.0",
  "description": "Minimal runtime i18n (t(key, params)) for Kiritan, with no build-time dependencies / Kiritanの最小ランタイムi18n(t(key, params))。ビルド時依存なし",
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "runtime",
    "kiritan"
  ],
  "homepage": "https://github.com/otnc/kiritan#readme",
  "bugs": {
    "url": "https://github.com/otnc/kiritan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/kiritan.git",
    "directory": "packages/runtime"
  },
  "license": "WTFPL",
  "author": "otoneko.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  }
}
