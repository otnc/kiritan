{
  "name": "@kiritan/deepl",
  "version": "0.1.0",
  "description": "A DeepL translate middleware for Kiritan / KiritanのDeepL翻訳ミドルウェア",
  "keywords": [
    "deepl",
    "translate",
    "translation",
    "machine-translation",
    "middleware",
    "i18n",
    "kiritan"
  ],
  "homepage": "https://github.com/otnc/kiritan#readme",
  "bugs": {
    "url": "https://github.com/otnc/kiritan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/kiritan.git",
    "directory": "packages/deepl"
  },
  "license": "WTFPL",
  "author": "otoneko.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiritan/middleware": "^0.1.0",
    "html-entities": "^2.6.0",
    "ofetch": "^1.5.1"
  }
}
