{
  "name": "@kiritan/free-translate",
  "version": "0.1.1",
  "description": "Translate middlewares that need no API key: MyMemory, Google's keyless endpoint, self-hosted LibreTranslate and Google Apps Script / APIキー不要の翻訳ミドルウェア: MyMemory、Googleのキーレスエンドポイント、自前ホストのLibreTranslateとGoogle Apps Script",
  "keywords": [
    "translate",
    "translation",
    "free",
    "no-api-key",
    "mymemory",
    "middleware",
    "i18n",
    "kiritan",
    "libretranslate",
    "google-apps-script",
    "self-hosted"
  ],
  "homepage": "https://github.com/otnc/kiritan#readme",
  "bugs": {
    "url": "https://github.com/otnc/kiritan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/kiritan.git",
    "directory": "packages/free-translate"
  },
  "license": "WTFPL",
  "author": "otoneko.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiritan/middleware": "^0.1.1",
    "html-entities": "^2.6.0",
    "ofetch": "^1.5.1"
  }
}
